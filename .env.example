# =====================================================================
# Business Analytics Consultant — Environment Configuration
# =====================================================================

# Server configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# Database configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Note: If PostgreSQL is not yet configured or reachable, the application
# automatically falls back to local SQLite (sqlite:///./consultant.db) for
# seamless development and evaluation.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/consultant_db

# File Storage Configuration
UPLOAD_DIR=./data_storage/uploads
MAX_UPLOAD_SIZE_MB=50
